{
  "name": "bun-php",
  "version": "1.0.0",
  "description": "Import .php files into Bun and call PHP functions as async JavaScript functions.",
  "keywords": [
    "bun",
    "bun-plugin",
    "php",
    "php-wasm",
    "wasm"
  ],
  "homepage": "https://github.com/khromov/bun-php#readme",
  "bugs": {
    "url": "https://github.com/khromov/bun-php/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khromov/bun-php.git"
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./runtime": "./src/runtime.ts",
    "./interpreter": "./src/interpreter.ts",
    "./types": "./types/php.d.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:versions": "bun test test/versions.test.ts",
    "php-builds:install": "bun scripts/php-builds-install.ts",
    "example": "bun run example/index.ts",
    "typecheck": "bunx --package typescript@5.9.2 tsc -p tsconfig.json",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "demos": "bun run demos/index.ts",
    "demos:vendor:pack": "composer install --working-dir=demos --no-interaction && cd demos && rm -f vendor.zip && zip -qr vendor.zip vendor",
    "demos:vendor:unpack": "cd demos && unzip -oq vendor.zip",
    "inline": "bun run demos/inline.ts",
    "phpinfo": "bun run demos/phpinfo.ts"
  },
  "dependencies": {
    "@php-wasm/node-8-5": "^3.1.51",
    "@php-wasm/universal": "^3.1.51",
    "@php-wasm/util": "^3.1.51",
    "php-parser": "^3.7.0"
  },
  "devDependencies": {
    "@php-wasm/node-8-3": "^3.1.51",
    "@types/bun": "latest",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0"
  },
  "peerDependencies": {
    "@php-wasm/node-8-0": "^3.1.51",
    "@php-wasm/node-8-1": "^3.1.51",
    "@php-wasm/node-8-2": "^3.1.51",
    "@php-wasm/node-8-3": "^3.1.51",
    "@php-wasm/node-8-4": "^3.1.51",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@php-wasm/node-8-0": {
      "optional": true
    },
    "@php-wasm/node-8-1": {
      "optional": true
    },
    "@php-wasm/node-8-2": {
      "optional": true
    },
    "@php-wasm/node-8-3": {
      "optional": true
    },
    "@php-wasm/node-8-4": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
